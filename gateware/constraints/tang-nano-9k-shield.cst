// =============================================================================
// Tang Nano 9K Shield – physical constraints (Gowin GW1NR-9, QN88P)
// =============================================================================
// Pin numbers verified against:
//   - hardware/tang-nano-9k-shield.kicad_sch (U2 pin -> net label)
//   - hardware/tang-nano-9k-shield.kicad_pcb (U2 pad -> net, U12/J8 for Pmod)
//   - Sipeed Tang Nano 9K schematic 3674 (2024-03-11): bank voltages,
//     clock, LEDs, buttons, HDMI, SD card
//
// Bank voltages on the Tang Nano 9K:
//   VCCO0/1/2 = 3.3 V -> LVCMOS33 (VGA, PS/2, SPI, clock)
//   VCCO3     = 1.8 V -> LVCMOS18 (Pmod 79-86, LEDs, buttons)
//
// Comment out any port your design does not use – Gowin reports an error
// for constraints on ports that do not exist in the top module.
// =============================================================================


// ---------------------------------------------------------------------------
// Onboard Tang Nano 9K resources
// ---------------------------------------------------------------------------

// 27 MHz crystal oscillator
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 6 orange LEDs, active LOW (anode on VCCO3_1V8)
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// 2 push buttons, active LOW (10k pull-up to VCCO3_1V8 on the Tang)
// Pin 4 is also JTAG_SEL: to use it as GPIO enable
// Project -> Configuration -> Dual-Purpose Pin -> "Use JTAG as regular IO".
IO_LOC  "btn[0]" 3;     // Tang net PIN3_IOT2A_BUTTON_S1
IO_LOC  "btn[1]" 4;     // Tang net PIN4_IOL5A_JTAG_SEL_S2
IO_PORT "btn[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_PORT "btn[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;


// ---------------------------------------------------------------------------
// VGA (J2, DE-15) – 4-bit binary-weighted resistor DAC per channel (RGB444)
// Bit 0 = LSB (3.9k), 1 = 2k, 2 = 1k, bit 3 = MSB (510R); HS/VS via 100R
// ---------------------------------------------------------------------------
IO_LOC  "vga_r[0]" 57;
IO_LOC  "vga_r[1]" 56;
IO_LOC  "vga_r[2]" 55;
IO_LOC  "vga_r[3]" 54;
IO_LOC  "vga_g[0]" 53;
IO_LOC  "vga_g[1]" 51;
IO_LOC  "vga_g[2]" 42;
IO_LOC  "vga_g[3]" 41;
IO_LOC  "vga_b[0]" 35;
IO_LOC  "vga_b[1]" 40;
IO_LOC  "vga_b[2]" 34;
IO_LOC  "vga_b[3]" 33;
IO_LOC  "vga_hs"   30;
IO_LOC  "vga_vs"   29;

IO_PORT "vga_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_hs"   IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "vga_vs"   IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;


// ---------------------------------------------------------------------------
// PS/2 (U1, stacked mini-DIN 6) via BSS138 level shifters to 5 V
// External 4.7k pull-ups on both sides -> no internal pull.
// Drive as open-drain in HDL:  assign ps2_clk[n] = drive_low ? 1'b0 : 1'bz;
//   index 0 = PS/2 #1 (U1 pins 1-6), index 1 = PS/2 #2 (U1 pins 7-12)
// ---------------------------------------------------------------------------
IO_LOC  "ps2_clk[0]" 49;
IO_LOC  "ps2_dat[0]" 48;
IO_LOC  "ps2_clk[1]" 32;
IO_LOC  "ps2_dat[1]" 31;
IO_PORT "ps2_clk[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "ps2_dat[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "ps2_clk[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "ps2_dat[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;


// ---------------------------------------------------------------------------
// SPI bus – FPGA is master
// Shared by: RP2040 (CS1/INT1), SPI header J5 (CS2/INT2) and the Tang's
// onboard microSD slot (SD CS = pin 38). Keep every unused CS HIGH.
// ---------------------------------------------------------------------------
IO_LOC  "spi_sck"  36;
IO_LOC  "spi_mosi" 37;
IO_LOC  "spi_miso" 39;
IO_LOC  "spi_cs1"  25;   // -> RP2040 (GPIO17, SPI0 CSn)
IO_LOC  "spi_int1" 26;   // <- RP2040 (GPIO20)
IO_LOC  "spi_cs2"  27;   // -> SPI header J5 pin 6
IO_LOC  "spi_int2" 28;   // <- SPI header J5 pin 7
IO_LOC  "sd_cs"    38;   // -> Tang onboard microSD (not routed on the shield)

IO_PORT "spi_sck"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "spi_cs1"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "spi_int1" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "spi_cs2"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "spi_int2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sd_cs"    IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;


// ---------------------------------------------------------------------------
// Pmod (J8, 2x6) via TXS0108E: FPGA side 1.8 V, Pmod side 3.3 V
// No internal pulls – they fight the TXS0108E one-shot edge accelerators.
// Bus pmod[7:0]; Digilent Pmod pin numbers are in the comments
// (pins 1-4 = top row, 7-10 = bottom row, 5/11 GND, 6/12 3V3).
// Pin 86 is also BL_PWM for the Tang's LCD connector – leave the LCD unplugged.
// ---------------------------------------------------------------------------
IO_LOC  "pmod[0]" 86;   // Pmod pin 1   (TXS A1 -> B1)
IO_LOC  "pmod[1]" 84;   // Pmod pin 2   (TXS A3 -> B3)
IO_LOC  "pmod[2]" 82;   // Pmod pin 3   (TXS A5 -> B5)
IO_LOC  "pmod[3]" 80;   // Pmod pin 4   (TXS A7 -> B7)
IO_LOC  "pmod[4]" 85;   // Pmod pin 7   (TXS A2 -> B2)
IO_LOC  "pmod[5]" 83;   // Pmod pin 8   (TXS A4 -> B4)
IO_LOC  "pmod[6]" 81;   // Pmod pin 9   (TXS A6 -> B6)
IO_LOC  "pmod[7]" 79;   // Pmod pin 10  (TXS A8 -> B8)

IO_PORT "pmod[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[6]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "pmod[7]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;


// ---------------------------------------------------------------------------
// Optional: Tang onboard HDMI (pins 68-75 are not routed on the shield)
// Use with ELVDS_OBUF / TLVDS_OBUF in HDL; constrain only the _p port.
// ---------------------------------------------------------------------------
// IO_LOC  "tmds_clk_p"  69,68;
// IO_LOC  "tmds_d_p[0]" 71,70;
// IO_LOC  "tmds_d_p[1]" 73,72;
// IO_LOC  "tmds_d_p[2]" 75,74;
// IO_PORT "tmds_clk_p"  IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
// IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
// IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
// IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
